<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Guia do Nome Limpo — Renegocie suas dívidas com segurança</title>
<meta name="description" content="Conteúdo educativo sobre dívidas e renegociação, com uma calculadora ilustrativa de desconto.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  /* ============ TOKENS ============ */
  :root{
    --navy-900:#0a1a30;
    --navy-800:#0f2745;
    --navy-700:#16345e;
    --blue-500:#2f6fed;
    --blue-400:#5b8fff;
    --gray-600:#5b6b82;
    --gray-300:#c4cedd;
    --gray-100:#eef1f6;
    --white:#ffffff;
    --clean-green:#1fae6f;
    --clean-green-soft:#e4f7ee;
    --dirty-red:#e35b5b;

    --font-display:'Space Grotesk', sans-serif;
    --font-body:'Inter', sans-serif;
    --font-mono:'JetBrains Mono', monospace;

    --radius-sm:6px;
    --radius-md:10px;
    --radius-lg:18px;
    --max-w:1180px;
  }

  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:var(--font-body);
    background:var(--gray-100);
    color:var(--navy-900);
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  img,svg{display:block; max-width:100%;}
  a{color:inherit; text-decoration:none;}
  ul{list-style:none;}
  button{font-family:inherit; cursor:pointer;}
  :focus-visible{outline:2px solid var(--blue-400); outline-offset:2px;}
  .wrap{max-width:var(--max-w); margin:0 auto; padding:0 24px;}
  .eyebrow{
    font-family:var(--font-mono);
    font-size:.72rem;
    letter-spacing:.14em;
    text-transform:uppercase;
    font-weight:600;
  }

  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; scroll-behavior:auto !important;}
  }

  /* ============ BUTTONS ============ */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    font-weight: 600;
    font-size: 0.9rem;
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }
  .btn-primary {
    background: var(--blue-500);
    color: var(--white);
  }
  .btn-primary:hover {
    background: var(--blue-400);
  }
  .btn-ghost {
    background: transparent;
    color: var(--navy-900);
    border-color: var(--gray-300);
  }
  .btn-ghost:hover {
    background: rgba(0,0,0,0.05);
  }

  /* ============ MARQUEE STATUS BAR ============ */
  .status-bar{
    background:var(--navy-900);
    color:var(--gray-300);
    font-family:var(--font-mono);
    font-size:.75rem;
    padding:7px 0;
    border-bottom:1px solid rgba(255,255,255,.08);
  }
  .status-bar .wrap{display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;}
  .status-bar .dot{
    display:inline-block; width:6px; height:6px; border-radius:50%;
    background:var(--clean-green); margin-right:6px;
    box-shadow:0 0 0 3px rgba(31,174,111,.18);
  }
  .status-bar .items{display:flex; gap:22px; flex-wrap:wrap;}

  /* ============ HEADER ============ */
  header.site {
    background: var(--white);
    border-bottom: 1px solid var(--gray-300);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 24px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--navy-900);
    white-space: nowrap;
  }
  .logo .mark {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
  }
  .logo small {
    display: block;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--gray-600);
  }
  nav.primary ul {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  nav.primary a {
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--navy-900);
    transition: color 0.2s ease;
  }
  nav.primary a:hover {
    color: var(--blue-500);
  }
  
  /* ============ DROPDOWN MENU UX ============ */
  .has-dropdown {
    position: relative;
  }
  /* Ponte invisível para evitar que o mouse saia do elemento e feche o menu */
  @media (min-width: 721px) {
    .has-dropdown::after {
      content: '';
      position: absolute;
      bottom: -15px; 
      left: 0;
      width: 100%;
      height: 15px;
    }
  }
  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(15px); /* Inicia mais abaixo */
    background: var(--white);
    border: 1px solid var(--gray-300);
    border-top: 3px solid var(--blue-500); /* Destaque visual forte */
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    box-shadow: 0 14px 30px rgba(10,26,48,0.12); /* Sombra mais refinada */
    min-width: 240px;
    padding: 8px 0;
    opacity: 0;
    visibility: hidden;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1); /* Animação suave e elegante */
    display: flex;
    flex-direction: column;
    gap: 0;
    z-index: 10;
  }
  @media (min-width: 721px) {
    .has-dropdown:hover .dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateX(-50%) translateY(4px); /* Fica mais próximo do menu original */
    }
  }
  .dropdown-menu li {
    width: 100%;
  }
  .dropdown-menu a {
    display: block;
    padding: 10px 20px;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--navy-800);
    transition: all 0.2s ease;
  }
  .dropdown-menu a:hover {
    background: var(--gray-100);
    color: var(--blue-500);
    padding-left: 26px; /* Micro-interação: pequeno deslize ao passar o mouse */
  }

  .header-cta {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .menu-toggle {
    display: none;
    background: none;
    border: none;
    padding: 6px;
    flex-direction: column;
    gap: 4px;
  }
  .menu-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--navy-900);
  }

  /* ============ HERO ============ */
  .hero{
    background:linear-gradient(180deg, var(--navy-900) 0%, var(--navy-800) 62%, var(--navy-700) 100%);
    color:var(--white);
    padding:64px 0 84px;
    position:relative;
    overflow:hidden;
  }
  .hero::before{
    content:'';
    position:absolute; inset:0;
    background-image:
      linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);
    background-size:42px 42px;
    mask-image:radial-gradient(ellipse 80% 60% at 30% 20%, black, transparent);
  }
  .hero-inner{
    position:relative; z-index:1;
    display:grid; grid-template-columns:1.15fr .85fr; gap:56px; align-items:center;
  }
  .hero-eyebrow{color:var(--blue-400); margin-bottom:18px; display:flex; align-items:center; gap:8px;}
  .hero h1{
    font-family:var(--font-display); font-weight:700;
    font-size:clamp(2.1rem, 3.6vw, 3.2rem);
    line-height:1.08; letter-spacing:-.01em;
    margin-bottom:20px;
  }
  .hero h1 .accent{color:var(--clean-green);}
  .hero p.lede{
    font-size:1.08rem; color:var(--gray-300); max-width:52ch;
    margin-bottom:32px;
  }
  .hero-actions{display:flex; gap:14px; flex-wrap:wrap; margin-bottom:36px;}
  .btn-lg{padding:15px 28px; font-size:.95rem;}
  .btn-primary.btn-lg{box-shadow:0 10px 30px rgba(47,111,237,.35);}
  .hero-trust{display:flex; gap:28px; flex-wrap:wrap; color:var(--gray-300); font-size:.82rem;}
  .hero-trust li{display:flex; align-items:center; gap:8px;}
  .hero-trust svg{width:16px; height:16px; color:var(--clean-green);}

  /* SIGNATURE: score dial */
  .dial-card{
    background:rgba(255,255,255,.04);
    border:1px solid rgba(255,255,255,.1);
    border-radius:var(--radius-lg);
    padding:28px 26px 24px;
    backdrop-filter:blur(6px);
  }
  .dial-card .dial-label{font-size:.78rem; color:var(--gray-300); margin-bottom:6px;}
  .dial-wrap{display:flex; justify-content:center; margin:6px 0 10px;}
  .dial-value{
    font-family:var(--font-display); font-weight:700; font-size:2.4rem;
    text-align:center; color:var(--white);
  }
  .dial-value span{font-size:1rem; font-weight:600; color:var(--clean-green); display:block; margin-top:2px;}
  .dial-scale{display:flex; justify-content:space-between; font-family:var(--font-mono); font-size:.68rem; color:var(--gray-300); margin-top:8px;}
  .dial-arc-neg{stroke:var(--dirty-red); opacity:.35;}
  .dial-arc-pos{stroke:var(--clean-green); stroke-dasharray:251; stroke-dashoffset:90; transition:stroke-dashoffset 1s ease;}
  .dial-needle{transform-origin:100px 100px; transform:rotate(15deg);}

  /* ============ SECTION HEADERS ============ */
  .section{padding:56px 0;}
  .section-head{
    display:flex; align-items:flex-end; justify-content:space-between;
    margin-bottom:30px; gap:20px; flex-wrap:wrap;
    border-bottom:1px solid var(--gray-300); padding-bottom:16px;
  }
  .section-head h2{
    font-family:var(--font-display); font-weight:700; font-size:1.5rem; color:var(--navy-900);
  }
  .section-head .eyebrow{color:var(--blue-500); display:block; margin-bottom:6px;}
  .section-head .see-all{font-weight:700; font-size:.85rem; color:var(--blue-500); white-space:nowrap;}
  .section-head .see-all:hover{text-decoration:underline;}

  /* ============ CONTENT LAYOUT ============ */
  .content-layout{
    display:grid; grid-template-columns:1fr 340px; gap:40px; align-items:start;
  }

  .article-grid{
    display:grid; grid-template-columns:repeat(2, 1fr); gap:24px;
  }
  .article-grid > .featured{grid-column:1 / -1;}

  .card{
    background:var(--white); border:1px solid var(--gray-300);
    border-radius:var(--radius-md); overflow:hidden;
    display:flex; flex-direction:column;
    transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }
  .card:hover{transform:translateY(-3px); box-shadow:0 14px 30px rgba(10,26,48,.09); border-color:var(--gray-300);}
  .card .thumb{
    height:150px; position:relative;
    background:linear-gradient(135deg, var(--navy-800), var(--navy-700));
    display:flex; align-items:center; justify-content:center;
  }
  .card.featured .thumb{height:230px;}
  .card .thumb svg{width:48px; height:48px; color:rgba(255,255,255,.35);}
  .tag{
    position:absolute; top:14px; left:14px;
    background:rgba(255,255,255,.95); color:var(--navy-800);
    font-size:.68rem; font-weight:700; letter-spacing:.03em; text-transform:uppercase;
    padding:5px 10px; border-radius:100px;
  }
  .tag.tag-green{background:var(--clean-green-soft); color:var(--clean-green);}
  .card .body{padding:20px; display:flex; flex-direction:column; gap:10px; flex:1;}
  .card h3{
    font-family:var(--font-display); font-weight:600; font-size:1.05rem; line-height:1.3; color:var(--navy-900);
  }
  .card.featured h3{font-size:1.5rem;}
  .card p{color:var(--gray-600); font-size:.9rem; line-height:1.55;}
  .card .meta{
    margin-top:auto; display:flex; align-items:center; gap:10px;
    font-family:var(--font-mono); font-size:.72rem; color:var(--gray-600);
    padding-top:10px; border-top:1px dashed var(--gray-300);
  }
  .card .meta .dot-sep{width:3px; height:3px; border-radius:50%; background:var(--gray-600);}

  /* ============ SIDEBAR ============ */
  .sidebar{display:flex; flex-direction:column; gap:24px; position:sticky; top:92px;}
  .side-block{
    background:var(--white); border:1px solid var(--gray-300); border-radius:var(--radius-md);
    padding:22px;
  }
  .side-block h4{
    font-family:var(--font-display); font-weight:600; font-size:.98rem; margin-bottom:14px;
    display:flex; align-items:center; gap:8px;
  }
  .side-block h4 svg{width:18px; height:18px; color:var(--blue-500);}

  .calc-field{margin-bottom:14px;}
  .calc-field label{
    display:block; font-size:.76rem; font-weight:600; color:var(--gray-600); margin-bottom:6px;
  }
  .calc-result{
    margin-top:16px; background:var(--clean-green-soft); border-radius:var(--radius-sm);
    padding:14px; display:flex; justify-content:space-between; align-items:center;
  }
  .calc-result .label{font-size:.76rem; color:var(--gray-600); font-weight:600;}
  .calc-result .value{font-family:var(--font-mono); font-weight:700; color:var(--clean-green); font-size:1.15rem;}
  .calc-cta{
    display:block; width:100%; margin-top:14px; text-align:center;
    background:var(--navy-900); color:var(--white); padding:12px; border-radius:var(--radius-sm);
    font-weight:700; font-size:.85rem;
  }
  .calc-cta:hover{background:var(--blue-500);}

  .newsletter-block{
    background:var(--navy-900); color:var(--white); border-radius:var(--radius-md); padding:22px;
  }
  .newsletter-block h4{color:var(--white);}
  .newsletter-block p{font-size:.85rem; color:var(--gray-300); margin-bottom:14px; line-height:1.5;}
  .newsletter-form{display:flex; gap:8px;}
  .newsletter-form input{
    flex:1; min-width:0; padding:11px 12px; border-radius:var(--radius-sm); border:1px solid rgba(255,255,255,.18);
    background:rgba(255,255,255,.06); color:var(--white); font-size:.85rem;
  }
  .newsletter-form input::placeholder{color:var(--gray-300);}
  .newsletter-form button{
    background:var(--blue-500); color:var(--white); border:none; border-radius:var(--radius-sm);
    padding:0 16px; font-weight:700; font-size:.85rem;
  }
  .newsletter-form button:hover{background:var(--blue-400);}

  /* ============ TICKER STRIP ============ */
  .ticker{
    background:var(--navy-800); color:var(--gray-300); overflow:hidden;
    padding:12px 0; border-top:1px solid rgba(255,255,255,.08); border-bottom:1px solid rgba(255,255,255,.08);
  }
  .ticker-track{display:flex; gap:48px; white-space:nowrap; animation:scroll-left 32s linear infinite;}
  .ticker-track span{font-family:var(--font-mono); font-size:.78rem; display:flex; align-items:center; gap:8px;}
  .ticker-track b{color:var(--clean-green);}
  @keyframes scroll-left{
    from{transform:translateX(0);}
    to{transform:translateX(-50%);}
  }

  /* ============ FOOTER ============ */
  footer.site{background:var(--navy-900); color:var(--gray-300); padding:56px 0 0; margin-top:64px;}
  .footer-grid{
    display:grid; grid-template-columns:1.4fr repeat(3, 1fr); gap:40px;
    padding-bottom:40px; border-bottom:1px solid rgba(255,255,255,.1);
  }
  .footer-brand .logo{color:var(--white);}
  .footer-brand p{font-size:.85rem; color:var(--gray-300); margin-top:14px; max-width:32ch; line-height:1.6;}
  .footer-col h5{
    font-size:.78rem; text-transform:uppercase; letter-spacing:.08em; color:var(--white);
    margin-bottom:16px; font-weight:700;
  }
  .footer-col ul{display:flex; flex-direction:column; gap:11px;}
  .footer-col a{font-size:.87rem; color:var(--gray-300);}
  .footer-col a:hover{color:var(--white);}
  .footer-bottom{
    padding:22px 0 28px; display:flex; justify-content:space-between; align-items:center;
    flex-wrap:wrap; gap:14px; font-size:.78rem; color:var(--gray-300);
  }
  .footer-bottom .legal-links{display:flex; gap:20px;}
  .footer-bottom .legal-links a:hover{color:var(--white); text-decoration:underline;}

  /* ============ RESPONSIVE ============ */
  @media (max-width: 980px){
    .content-layout{grid-template-columns:1fr;}
    .sidebar{position:static; display:grid; grid-template-columns:1fr 1fr; gap:20px;}
    .hero-inner{grid-template-columns:1fr;}
    .dial-card{max-width:360px; margin:0 auto;}
    .footer-grid{grid-template-columns:1fr 1fr;}
  }
  @media (max-width: 720px){
    nav.primary{
      position:fixed; inset:64px 0 0 0; background:var(--white);
      transform:translateX(100%); transition:transform .25s ease; padding:24px;
      overflow-y:auto;
    }
    nav.primary.open{transform:translateX(0);}
    nav.primary ul{flex-direction:column; align-items:flex-start; gap:22px;}
    
    .dropdown-menu {
      position: static;
      transform: none;
      box-shadow: none;
      border: none;
      border-left: 2px solid var(--gray-300);
      margin-top: 10px;
      margin-left: 10px;
      opacity: 1;
      visibility: visible;
      padding: 0;
    }
    .dropdown-menu a {
      padding: 8px 20px;
    }
    .dropdown-menu a:hover {
      padding-left: 20px; /* Desativa micro-interação no mobile para evitar saltos na tela */
    }

    .menu-toggle{display:flex;}
    .header-cta .btn-ghost{display:none;}
    .article-grid{grid-template-columns:1fr;}
    .sidebar{grid-template-columns:1fr;}
    .footer-grid{grid-template-columns:1fr;}
    .status-bar .items{display:none;}
    .hero{padding:44px 0 56px;}
  }
</style>
{% include "partials/responsive-assets.njk" %}
</head>
<body>

 <!-- ============ STATUS BAR ============ -->
  <div class="status-bar">
    <div class="wrap">
      <span><span class="dot"></span>Conteúdo informativo sobre crédito e renegociação</span>
      <div class="items"></div>
    </div>
  </div>

  <!-- ============ HEADER ============ -->
  {% include "partials/navigation.njk" %}

  <!-- ============ HERO ============ -->
  <section class="hero" id="topo">
    <div class="wrap hero-inner">
      <div>
        <div class="eyebrow hero-eyebrow">● GUIA PRÁTICO DE RENEGOCIAÇÃO</div>
        <h1>Seu caminho do nome sujo ao <span class="accent">nome limpo</span> começa com uma decisão informada.</h1>
        <p class="lede">Reunimos informações introdutórias sobre renegociação e organização das dívidas. Compare sempre as condições com as ofertas disponíveis nos canais oficiais.</p>
        <div class="hero-actions">
          <a href="guias-de-renegociacao.html" class="btn btn-primary btn-lg">Ver dicas de renegociação →</a>
          <a href="#calculadora" class="btn btn-ghost btn-lg" style="border-color:rgba(255,255,255,.3); color:#fff;">Usar calculadora de desconto</a>
        </div>
        <ul class="hero-trust">
          <li><svg viewBox="0 0 20 20" fill="none"><path d="M4 10l4 4 8-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Conteúdo informativo e gratuito</li>
          <li><svg viewBox="0 0 20 20" fill="none"><path d="M4 10l4 4 8-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Sem consulta real de CPF ou score</li>
        </ul>
      </div>

      <div class="dial-card">
        <div class="dial-label eyebrow">SIMULAÇÃO · SCORE DE CRÉDITO</div>
        <div class="dial-wrap">
          <svg width="200" height="120" viewBox="0 0 200 120">
            <path d="M20 100 A80 80 0 0 1 180 100" stroke="#22344f" stroke-width="14" fill="none" stroke-linecap="round"/>
            <path class="dial-arc-pos" d="M20 100 A80 80 0 0 1 180 100" stroke-width="14" fill="none" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="dial-value">—<span>Exemplo visual; não representa uma consulta real</span></div>
        <div class="dial-scale"><span>0</span><span>300</span><span>600</span><span>1000</span></div>
      </div>
    </div>
  </section>

  <!-- Indicadores de mercado serão publicados apenas com fonte e data de conferência. -->

  <!-- ============ MAIN CONTENT ============ -->
  <main id="main-content" tabindex="-1" class="wrap">

    <section class="section" id="artigos">
      <div class="content-layout">

        <!-- ARTICLES -->
        <div>
          <div class="section-head">
            <div>
              <span class="eyebrow">EDITORIAL</span>
              <h2>Artigos recentes</h2>
            </div>
            <a href="todos-os-artigos.html" class="see-all">Ver todos os artigos →</a>
          </div>

          <div class="article-grid">

            {% for article in collections.articles | take(3) %}
            <a href="{{ article.url }}" class="card featured">
              <div class="thumb">
                <span class="tag tag-green">{{ article.data.category }}</span>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="{{ article.data.iconPath }}" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <div class="body">
                <h3>{{ article.data.title }}</h3>
                <p>{{ article.data.excerpt }}</p>
                <div class="meta"><span>{{ article.data.category }}</span><span class="dot-sep"></span><span>{{ article.data.readTime }}</span></div>
              </div>
            </a>
            {% else %}
            <p>Ainda não há artigos publicados.</p>
            {% endfor %}

          </div>
        </div>

        <!-- SIDEBAR -->
        <aside class="sidebar" id="calculadora">

          <!-- BLOCO DE ANÚNCIO 1 -->
          <div class="side-block">
