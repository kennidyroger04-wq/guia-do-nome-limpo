<title>Política de Privacidade — Guia do Nome Limpo</title>
<meta name="description" content="Informações sobre privacidade e tratamento de dados no site Guia do Nome Limpo.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  /* ============ TOKENS ============ */
  :root{
    --navy-900:#0a1a30;
    --navy-800:#0f2745;
    --navy-700:#16345e;
    --blue-500:#2f6fed;
    --blue-400:#5b8fff;
    --gray-600:#5b6b82;
    --gray-300:#c4cedd;
    --gray-100:#eef1f6;
    --white:#ffffff;
    --clean-green:#1fae6f;
    --clean-green-soft:#e4f7ee;
    --dirty-red:#e35b5b;

    --font-display:'Space Grotesk', sans-serif;
    --font-body:'Inter', sans-serif;
    --font-mono:'JetBrains Mono', monospace;

    --radius-sm:6px;
    --radius-md:10px;
    --radius-lg:18px;
    --max-w:1180px;
  }

  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:var(--font-body);
    background:var(--gray-100);
    color:var(--navy-900);
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  img,svg{display:block; max-width:100%;}
  a{color:inherit; text-decoration:none;}
  ul{list-style:none;}
  button{font-family:inherit; cursor:pointer;}
  :focus-visible{outline:2px solid var(--blue-400); outline-offset:2px;}
  .wrap{max-width:var(--max-w); margin:0 auto; padding:0 24px;}
  .eyebrow{
    font-family:var(--font-mono);
    font-size:.72rem;
    letter-spacing:.14em;
    text-transform:uppercase;
    font-weight:600;
  }

  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; scroll-behavior:auto !important;}
  }

  /* ============ MARQUEE STATUS BAR ============ */
  .status-bar{
    background:var(--navy-900);
    color:var(--gray-300);
    font-family:var(--font-mono);
    font-size:.75rem;
    padding:7px 0;
    border-bottom:1px solid rgba(255,255,255,.08);
  }
  .status-bar .wrap{display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;}
  .status-bar .dot{
    display:inline-block; width:6px; height:6px; border-radius:50%;
    background:var(--clean-green); margin-right:6px;
    box-shadow:0 0 0 3px rgba(31,174,111,.18);
  }
  .status-bar .items{display:flex; gap:22px; flex-wrap:wrap;}

  /* ============ HEADER ============ */
  header.site{
    background:var(--white);
    border-bottom:1px solid var(--gray-300);
    position:sticky; top:0; z-index:100;
  }
  .header-inner{
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 24px; gap:24px;
  }
  .logo{
    display:flex; align-items:center; gap:10px;
    font-family:var(--font-display);
    font-weight:700; font-size:1.28rem;
    color:var(--navy-900);
  }
  .logo .mark{
    width:34px; height:34px; flex-shrink:0;
  }
  .logo small{
    display:block; font-family:var(--font-body); font-weight:500;
    font-size:.62rem; color:var(--gray-600); letter-spacing:.03em;
  }
  nav.primary ul{display:flex; gap:30px; align-items:center;}
  nav.primary a{
    font-size:.92rem; font-weight:600; color:var(--navy-800);
    position:relative; padding:6px 0;
  }
  nav.primary a::after{
    content:''; position:absolute; left:0; bottom:0; height:2px; width:0;
    background:var(--blue-500); transition:width .2s ease;
  }
  nav.primary a:hover::after{width:100%;}
  .header-cta{display:flex; align-items:center; gap:14px;}
  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:8px;
    font-weight:700; font-size:.88rem; border:none;
    border-radius:var(--radius-sm); padding:12px 22px;
    transition:transform .15s ease, box-shadow .15s ease, background .15s ease;
  }
  .btn-primary{background:var(--blue-500); color:var(--white);}
  .btn-primary:hover{background:var(--navy-700); transform:translateY(-1px); box-shadow:0 8px 20px rgba(47,111,237,.28);}
  .btn-ghost{background:transparent; color:var(--navy-800); border:1px solid var(--gray-300);}
  .btn-ghost:hover{border-color:var(--navy-800);}
  .menu-toggle{display:none; background:none; border:none; padding:6px;}
  .menu-toggle span{display:block; width:22px; height:2px; background:var(--navy-900); margin:5px 0;}

  /* ============ SECTION HEADERS (reused) ============ */
  .section{padding:56px 0;}
  .section-head{
    display:flex; align-items:flex-end; justify-content:space-between;
    margin-bottom:30px; gap:20px; flex-wrap:wrap;
    border-bottom:1px solid var(--gray-300); padding-bottom:16px;
  }
  .section-head h2{
    font-family:var(--font-display); font-weight:700; font-size:1.5rem; color:var(--navy-900);
  }
  .section-head .eyebrow{color:var(--blue-500); display:block; margin-bottom:6px;}

  /* ============ TICKER (reused for continuity) ============ */
  .ticker{
    background:var(--navy-800); color:var(--gray-300); overflow:hidden;
    padding:12px 0; border-top:1px solid rgba(255,255,255,.08); border-bottom:1px solid rgba(255,255,255,.08);
  }
  .ticker-track{display:flex; gap:48px; white-space:nowrap; animation:scroll-left 32s linear infinite;}
  .ticker-track span{font-family:var(--font-mono); font-size:.78rem; display:flex; align-items:center; gap:8px;}
  .ticker-track b{color:var(--clean-green);}
  @keyframes scroll-left{
    from{transform:translateX(0);}
    to{transform:translateX(-50%);}
  }

  /* ============ LEGAL PAGE HERO ============ */
  .legal-hero{
    background:linear-gradient(180deg, var(--navy-900) 0%, var(--navy-800) 100%);
    color:var(--white);
    padding:52px 0 56px;
  }
  .legal-hero .eyebrow{color:var(--blue-400); margin-bottom:14px;}
  .legal-hero h1{
    font-family:var(--font-display); font-weight:700;
    font-size:clamp(1.9rem, 3vw, 2.6rem); letter-spacing:-.01em; margin-bottom:12px;
  }
  .legal-hero p{color:var(--gray-300); max-width:60ch; font-size:1rem;}
  .legal-hero .updated{
    display:inline-flex; align-items:center; gap:8px; margin-top:20px;
    font-family:var(--font-mono); font-size:.76rem; color:var(--gray-300);
    background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.12);
    padding:8px 14px; border-radius:100px;
  }
  .legal-hero .updated .dot{width:6px; height:6px; border-radius:50%; background:var(--clean-green);}

  /* ============ LEGAL LAYOUT ============ */
  .legal-layout{
    display:grid; grid-template-columns:260px 1fr; gap:40px; align-items:start;
  }
  .toc{
    background:var(--white); border:1px solid var(--gray-300); border-radius:var(--radius-md);
    padding:22px; position:sticky; top:92px;
  }
  .toc h4{
    font-family:var(--font-display); font-weight:600; font-size:.92rem; margin-bottom:14px;
  }
  .toc ol{list-style:none; counter-reset:toc-counter; display:flex; flex-direction:column; gap:10px;}
  .toc li{counter-increment:toc-counter;}
  .toc a{
    display:flex; gap:10px; font-size:.85rem; color:var(--gray-600); font-weight:500;
    padding:4px 0; border-radius:4px; transition:color .15s ease;
  }
  .toc a::before{
    content:counter(toc-counter, decimal-leading-zero);
    font-family:var(--font-mono); font-size:.72rem; color:var(--blue-500); flex-shrink:0; padding-top:1px;
  }
  .toc a:hover{color:var(--navy-900);}

  .legal-content{
    background:var(--white); border:1px solid var(--gray-300); border-radius:var(--radius-md);
    padding:40px 44px;
  }
  .legal-content section{margin-bottom:36px; scroll-margin-top:100px;}
  .legal-content section:last-child{margin-bottom:0;}
  .legal-content h2{
    font-family:var(--font-display); font-weight:700; font-size:1.2rem; color:var(--navy-900);
    margin-bottom:14px; display:flex; align-items:center; gap:10px;
  }
  .legal-content h2 .num{
    font-family:var(--font-mono); font-size:.78rem; color:var(--blue-500);
    background:var(--gray-100); border-radius:6px; padding:3px 8px;
  }
  .legal-content h3{
    font-family:var(--font-display); font-weight:600; font-size:1rem; color:var(--navy-800);
    margin:18px 0 8px;
  }
  .legal-content p{color:var(--gray-600); font-size:.94rem; line-height:1.7; margin-bottom:12px;}
  .legal-content ul{list-style:none; display:flex; flex-direction:column; gap:8px; margin:12px 0 12px 0;}
  .legal-content ul li{
    color:var(--gray-600); font-size:.94rem; line-height:1.6; padding-left:20px; position:relative;
  }
  .legal-content ul li::before{
    content:''; position:absolute; left:0; top:9px; width:6px; height:6px; border-radius:50%;
    background:var(--blue-500);
  }
  .legal-content strong{color:var(--navy-900); font-weight:700;}
  .highlight-box{
    background:var(--clean-green-soft); border:1px solid rgba(31,174,111,.25); border-radius:var(--radius-sm);
    padding:16px 18px; margin:14px 0;
  }
  .highlight-box p{color:var(--navy-800); margin-bottom:0; font-size:.9rem;}
  .highlight-box p strong{color:var(--clean-green);}
  .ad-box{
    background:var(--gray-100); border:1px solid var(--gray-300); border-radius:var(--radius-sm);
    padding:16px 18px; margin:14px 0;
  }
  .ad-box p{margin-bottom:0; font-size:.9rem;}
  table.cookie-table{width:100%; border-collapse:collapse; margin:14px 0; font-size:.86rem;}
  table.cookie-table th, table.cookie-table td{
    text-align:left; padding:10px 12px; border-bottom:1px solid var(--gray-300); color:var(--gray-600);
  }
  table.cookie-table th{
    font-family:var(--font-mono); font-size:.7rem; text-transform:uppercase; letter-spacing:.06em;
    color:var(--navy-800); background:var(--gray-100);
  }
  table.cookie-table td strong{color:var(--navy-900);}
  .legal-content a.inline-link{color:var(--blue-500); font-weight:600; text-decoration:underline;}

  /* ============ FOOTER (reused) ============ */
  footer.site{background:var(--navy-900); color:var(--gray-300); padding:56px 0 0; margin-top:64px;}
  .footer-grid{
    display:grid; grid-template-columns:1.4fr repeat(3, 1fr); gap:40px;
    padding-bottom:40px; border-bottom:1px solid rgba(255,255,255,.1);
  }
  .footer-brand .logo{color:var(--white);}
  .footer-brand p{font-size:.85rem; color:var(--gray-300); margin-top:14px; max-width:32ch; line-height:1.6;}
  .footer-col h5{
    font-size:.78rem; text-transform:uppercase; letter-spacing:.08em; color:var(--white);
    margin-bottom:16px; font-weight:700;
  }
  .footer-col ul{display:flex; flex-direction:column; gap:11px;}
  .footer-col a{font-size:.87rem; color:var(--gray-300);}
  .footer-col a:hover{color:var(--white);}
  .footer-bottom{
    padding:22px 0 28px; display:flex; justify-content:space-between; align-items:center;
    flex-wrap:wrap; gap:14px; font-size:.78rem; color:var(--gray-300);
  }
  .footer-bottom .legal-links{display:flex; gap:20px;}
  .footer-bottom .legal-links a:hover{color:var(--white); text-decoration:underline;}

  /* ============ RESPONSIVE ============ */
  @media (max-width: 980px){
    .legal-layout{grid-template-columns:1fr;}
    .toc{position:static;}
    .legal-content{padding:30px 26px;}
    .footer-grid{grid-template-columns:1fr 1fr;}
  }
  @media (max-width: 720px){
    nav.primary{
      position:fixed; inset:64px 0 0 0; background:var(--white);
      transform:translateX(100%); transition:transform .25s ease; padding:24px;
    }
    nav.primary.open{transform:translateX(0);}
    nav.primary ul{flex-direction:column; align-items:flex-start; gap:22px;}
    .menu-toggle{display:block;}
    .header-cta .btn-ghost{display:none;}
    .footer-grid{grid-template-columns:1fr;}
    .status-bar .items{display:none;}
    table.cookie-table{display:block; overflow-x:auto; white-space:nowrap;}
  }
</style>
